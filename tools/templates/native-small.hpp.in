#pragma once
#include <algorithm>
#include <cmath>
namespace sbn::v3 {
// Saturated 16/W products, Zen5 Strix Halo, Clang 21.1.8; steady protocol.
// Generated by tools/generate_tuning.py from config/tuning/native-small.json.
// Calibration record SHA-256:
// SBN3_CFG_RECORD_HASH
// Private common-TU policy only. These costs cannot grant legality.
inline double small_mul_cost(const sbn3_mul_info &i,bool fresh_mul=true){
    constexpr double co[]={SBN3_CFG_COEFFICIENTS};
    constexpr double corr[]={SBN3_CFG_CORRECTIONS};
    double f[38]{};const double np=i.np,T=i.trunk_bits,C=i.C,M=i.M2,l=i.lbv,lw=i.lbw,w=i.workers,nc=std::ceil(48*np/52);
    const double nv=double((i.nat+7)/8+(i.nyt+7)/8),lr=std::log2(M),lc=std::log2(C),full=i.full;
    if(i.algorithm==SBN3_MUL_FLAT){
        const double waves=std::ceil(np/w),cache=std::max(0.,std::log2(160*M/(768*1024))),mem=std::max(0.,std::log2((16/w)*(np*32*M+std::min(np,w)*128*M)/(64*1024*1024)));
        const double chunks=std::ceil(double(i.emit_trunks)/4096),ve=std::min(w,chunks),e=l/ve;
        const double a[]={1,std::log2(w)+1,waves*nv*std::ceil(T/48),waves*std::max(0.,2*M-nv),waves*M*lr*full,waves*l*(lr+1)*(1-full),waves*l,waves*l*cache,waves*l*mem,e*(np==4?14:np*nc),e*i.digit_words,chunks/ve};
        std::copy(a,a+12,f+26);
    }else{
        const double vr=std::min(w,std::max(1.,C/4)),vx=std::min(w,std::max(1.,C/64)),vt=std::min(w,std::max(1.,np*std::ceil(std::ceil(lw/2)/8))),ve=std::min(w,std::max(1.,C/i.fused_row_grain));
        const double work=np*C*lw/vt,tilebytes=4*(C+8)*64+C*(96+73+32),r=np*(C+i.fused_items)/ve,e=(C+i.fused_items)*l/ve;
        const double a[]={1,std::log2(w)+1,np,T*nv/vx,np*nv*std::ceil(T/48)/vr,np*std::max(0.,2*C*M-nv)/vr,np*2*C*M*lr/vr*full,np*C*l*(lr+1)/vr*(1-full),np*C/vr,np*2*C*M/vr*std::fmod(lr,3)*full,
            std::ceil(np/i.prime_batch),std::log2(w)+1,work,work*lc,work*std::fmod(lc,3),work*std::max(0.,std::log2(tilebytes/(512*1024))),
            1,std::log2(w)+1,np,r,r*M*lr*full,r*l*(lr+1)*(1-full),r*std::max(0.,M-lw),e*(np==4?14:np*nc),e*i.digit_words,r*l*std::max(0.,std::log2(np*M*64/(512*1024)))};
        std::copy(a,a+26,f);
    }
    double raw=0,correction=0;for(unsigned j=0;j<38;++j)raw+=co[j]*f[j];unsigned k=0;
    for(unsigned v:{4u,5u,7u,8u})correction+=corr[k++]*(i.np==v);
    for(size_t v:{64u,128u,512u,1024u,2048u})correction+=corr[k++]*(i.C==v);
    for(size_t v:{16u,32u,64u,128u,512u,1024u,2048u})correction+=corr[k++]*(i.M2==v);
    correction+=corr[k++]*full;
    for(size_t v:{64u,128u,512u,1024u,2048u})correction+=corr[k++]*(i.C==v?(w-1)/15:0);
    for(size_t v:{16u,32u,64u,128u,512u,1024u,2048u})correction+=corr[k++]*(i.M2==v?full:0);
    for(unsigned v:{1u,2u,4u,8u,16u})correction+=corr[k++]*(i.algorithm==SBN3_MUL_FLAT && i.workers==v);
    for(unsigned v:{4u,5u,7u,8u})correction+=corr[k++]*(i.np==v?full:0);
    for(unsigned v:{4u,5u,7u,8u})correction+=corr[k++]*(i.np==v?std::log2(w)/4:0);
    for(unsigned npv:{4u,5u,7u,8u})for(unsigned wv:{1u,2u,4u,8u,16u})correction+=corr[k++]*(i.algorithm==SBN3_MUL_FLAT && i.np==npv && i.workers==wv);
    const bool one_buffer=i.algorithm==SBN3_MUL_FLAT && i.M2>=16384 && i.per_worker_bytes<96*i.M2;
    const double packed=one_buffer?(i.workers==1?.90:i.workers==2?.84:.79):1.;
    const double tail=fresh_mul && i.algorithm==SBN3_MUL_FLAT && i.np==10 && i.M2==16384?(i.workers==4?.92:i.workers==8?.90:1.):1.;
    return raw*std::exp(correction)*packed*tail;
}
}
