#pragma once
#include <stddef.h>
namespace sbn::v3 {
// Native profile: Clang 21.1.8, Zen5 Strix Halo, W16 balanced LIN.
// Fit even indices only; odd indices and longer shapes are validation.
// Generated by tools/generate_tuning.py from config/tuning/native-deep.json.
// These costs never grant mathematical or resource legality.
inline constexpr const char *mul_tuning_profile="zen5-strix-halo-clang21.1.8-20260906-fit2";
inline constexpr unsigned default_crt(unsigned np){return np==4?1:2;}
inline constexpr unsigned default_codec(int T,size_t M2){return T>88 && M2<=2048?3:1;}
inline constexpr double mul_np_cost[]={SBN3_CFG_NP_FACTORS};
inline constexpr double mul_m2_cost(size_t value){
    switch(value){case 1024:return SBN3_CFG_ROW_SLOTS_1024;case 4096:return SBN3_CFG_ROW_SLOTS_4096;case 8192:return SBN3_CFG_ROW_SLOTS_8192;case 16384:return SBN3_CFG_ROW_SLOTS_16384;default:return 1.;}
}
inline constexpr double mul_column_cost(size_t value){
    switch(value){case 1024:return SBN3_CFG_COLUMNS_1024;case 4096:return 1;case 8192:return SBN3_CFG_COLUMNS_8192;default:return 1.;}
}
inline constexpr double mul_codec_cost(unsigned T){return T==84?SBN3_CFG_CODEC_84:1.;}
inline constexpr double mul_large_rows_cost(unsigned np,size_t M2){
    if(M2!=8192)return 1.;
    switch(np){case 7:return SBN3_CFG_LARGE_ROWS_NP_7;case 8:return SBN3_CFG_LARGE_ROWS_NP_8;default:return 1.;}
}
}
